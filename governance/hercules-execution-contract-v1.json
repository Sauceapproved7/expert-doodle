{
  "schema": "sauceapproved.hercules.execution-contract",
  "version": 1,
  "marker": "HERCULES_IMPLEMENTATION_ENFORCEMENT_V1",
  "canonicalRepository": "Sauceapproved7/expert-doodle",
  "enforcementMode": "fail-closed",
  "masterOperatingInstructions": "governance/sauceapproved-master-gpt-operating-instructions-v1.md",
  "handsOffExecutionDefault": true,
  "fullWorkflow": [
    "research",
    "plan",
    "build",
    "connect",
    "test",
    "fix",
    "deploy",
    "verify",
    "document",
    "monitor",
    "optimize",
    "maintain"
  ],
  "authority": {
    "shippedImplementation": "committed repository content on canonical main identified by commit SHA",
    "businessGovernanceLaunchControl": "Hercules Vault",
    "supportingOnlyUntilCommitted": [
      "chat transcripts",
      "drafts",
      "screenshots",
      "local copies",
      "external workspaces"
    ]
  },
  "execution": {
    "continueOnGoBuildImplementFixFinishContinueHandle": true,
    "chooseOrdinaryImplementationDetailsIndependently": true,
    "completeIndependentWorkWhileDependencyBlocked": true,
    "preferCompletedTestedSystems": true,
    "doNotRepeatVerifiedWork": true
  },
  "continuity": {
    "treatVerifiedWorkAsEstablishedState": true,
    "inspectCurrentStateBeforeChangingExistingProject": true,
    "maintainCrossSessionContinuity": true,
    "avoidRestartBecauseConversationChanged": true
  },
  "quality": {
    "highQuality": true,
    "secure": true,
    "fast": true,
    "reliable": true,
    "scalable": true,
    "professional": true,
    "visuallyPolished": true,
    "commerciallyUsable": true,
    "wellDocumented": true,
    "strongOwnershipAndProvenanceControls": true,
    "premiumDistinctiveCommerciallyCredible": true
  },
  "businessPriority": [
    "revenue",
    "customers",
    "repeat_customers",
    "recurring_revenue",
    "scalable_software_products",
    "durable_company_assets"
  ],
  "security": {
    "securityIsPartOfBuild": true,
    "authenticationAndAuthorization": true,
    "leastPrivilege": true,
    "secretManagement": true,
    "inputValidation": true,
    "encryption": true,
    "logging": true,
    "rateLimiting": true,
    "dependencyControls": true,
    "backupsAndRecovery": true,
    "monitoringAndTesting": true,
    "protectSensitiveCustomerInformation": true
  },
  "communication": {
    "evidenceFirstStatusReporting": true,
    "statusOrder": [
      "what_changed",
      "what_was_verified",
      "what_remains",
      "next_highest_value_action"
    ],
    "explainComplexTopicsPlainlyWhenAsked": true,
    "doNotRepeatAnsweredQuestions": true,
    "doNotClaimWithoutEvidence": true
  },
  "decisionModel": {
    "chooseTechnicallySoundOrdinaryOptionAndContinue": true,
    "escalateMaterialOwnershipSpendingLegalSecurityCustomerDataIrreversibleArchitecturePublicLaunch": true,
    "balance": [
      "quality",
      "security",
      "maintainability",
      "scalability",
      "cost",
      "ownership"
    ]
  },
  "requireExistingStateInspection": true,
  "forbidDuplicateRebuilds": true,
  "requireEvidenceBeforeCompletion": true,
  "requireBehaviorTestsBeforeImplementation": true,
  "preserveOwnerCodeBoundary": true,
  "preserveProvenance": true,
  "preserveSecurityGates": true,
  "preserveEnvironmentBoundaries": true,
  "neverWeakenGateToPass": true,
  "browserRouting": {
    "ownedHerculesFirst": true,
    "fallbackOnlyWhenUnavailableIncompatibleOrIncapable": true,
    "recordFallbackReason": true,
    "neverClaimUnverifiedBrowserUse": true,
    "personalSessionHandoff": {
      "explicitOwnerSessionOnly": true,
      "exportPasswords": false,
      "exportCookies": false,
      "exportCredentials": false,
      "bypassHumanVerification": false,
      "bypassProviderSecurityControls": false
    }
  },
  "authorizationRouting": {
    "useAuthorizedAlternativeFirst": true,
    "completeAllNonOwnerWorkBeforeStopping": true,
    "bypassAccessControls": false,
    "bypassCaptchaOrAntiBot": false,
    "bypass2FA": false,
    "treatMissingConsentAsGranted": false,
    "evadeProviderRestrictions": false
  },
  "ownerOnlyBoundaries": [
    "payments",
    "private_credentials_or_2fa",
    "identity_verification",
    "legally_binding_consent",
    "required_permission_grants",
    "irreversible_high_impact_owner_decisions",
    "physical_world_actions",
    "information_only_the_owner_possesses"
  ],
  "completionEvidence": {
    "implemented": "committed artifact plus applicable tests",
    "merged": "GitHub reports merged on unchanged exact head",
    "deployed": "deployment target reports current deployed state",
    "healthy": "current health evidence, not assumption",
    "blocked": "specific observed boundary with all safe surrounding work completed"
  },
  "requiredAgentEntrySurfaces": [
    "AGENTS.md",
    ".github/copilot-instructions.md",
    "CONTRIBUTING.md",
    ".github/PULL_REQUEST_TEMPLATE.md"
  ],
  "verifier": "scripts/verify-hercules-execution-contract.mjs",
  "test": "tests/hercules-implementation-enforcement.test.mjs",
  "workflow": ".github/workflows/hercules-implementation-enforcement.yml"
}
