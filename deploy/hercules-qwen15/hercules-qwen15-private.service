# Hercules Qwen2.5-1.5B-Instruct: owner-private on-host inference only.
# NO public listener, cloud provisioning, billing mutation or public release.
# This unit is inert until the OWNER separately provisions a qualified machine,
# a protected /etc/hercules/qwen15-private.env and approval marker.
[Unit]
Description=Hercules private Qwen 1.5B inference (owner-controlled host only)
After=local-fs.target
ConditionPathExists=/etc/hercules/qwen15-private.approved
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
User=hercules-ai
Group=hercules-ai
WorkingDirectory=/opt/hercules/current
EnvironmentFile=/etc/hercules/qwen15-private.env
ExecStart=/usr/bin/node /opt/hercules/current/scripts/hercules-qwen15-owner-host.mjs
Restart=on-failure
RestartSec=30s
TimeoutStopSec=15s
KillMode=control-group
LimitCORE=0
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryAccounting=yes
CPUAccounting=yes
MemoryMax=4G
MemorySwapMax=0
CPUQuota=200%
TasksMax=64

[Install]
WantedBy=multi-user.target
